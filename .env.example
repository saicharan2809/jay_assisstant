# ========================================================
# Jay AI Assistant - Environment Configuration Template
# Copy this file to .env and configure your settings
# ========================================================

# LLM Brain (Ollama)
OLLAMA_MODEL=mistral

# Wake Word Settings
WAKE_WORD_MODEL=wake_word_model.pkl

# Voice & Speech Tuning
# Premium Edge-TTS Voices: en-US-GuyNeural, en-US-AriaNeural, en-GB-RyanNeural
TTS_VOICE=en-US-GuyNeural

# Local Speech-to-Text (Faster-Whisper Model: tiny.en, base.en, small.en)
WHISPER_MODEL=small.en

# Interrupt Sensitivity Multiplier (Higher = less sensitive to background room noise)
INTERRUPT_MULTIPLIER=4.0

# Optional Browser & Application Paths
BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
VLC_PATH=C:\Program Files\VideoLAN\VLC\vlc.exe

# Optional Cloud STT Fallback (Deepgram)
DEEPGRAM_API_KEY=
